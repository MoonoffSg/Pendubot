void  draw_Pendubot(PGraphics  pg, double stateL[], double uT, plant_t plantL)
{
    
    AxisRod(pg);
    pg.strokeWeight(2);
    pg.stroke(0, 0, 0);
    pg.fill(0, 0, 0);
    pg.ellipse(myScreen.xp(0), myScreen.yp(0), 20, 20);
    pg.strokeWeight(10);
    pg.line(myScreen.xp(0), myScreen.yp(0), 
          myScreen.xp(plantL.l1 * cos_db(stateL[2] + 3.1415 * 0.5)),
          myScreen.yp(plantL.l1 * sin_db(stateL[2] + 3.1415 * 0.5)));
    pg.fill(0, 0, 0);
    pg.ellipse(myScreen.xp(plantL.l1 * cos_db(stateL[2] + 3.1415 * 0.5)),
          myScreen.yp(plantL.l1 * sin_db(stateL[2] + 3.1415 * 0.5)), 20, 20);
    
    pg.line(myScreen.xp(plantL.l1 * cos_db(stateL[2] + 3.1415 * 0.5) + plantL.l2 * cos_db(stateL[3] + 3.1415 * 0.5)),
          myScreen.yp(plantL.l1 * sin_db(stateL[2] + 3.1415 * 0.5) + plantL.l2 * sin_db(stateL[3] + 3.1415 * 0.5)),
          myScreen.xp(plantL.l1 * cos_db(stateL[2] + 3.1415 * 0.5)),
          myScreen.yp(plantL.l1 * sin_db(stateL[2] + 3.1415 * 0.5)));
    //pg.fill(0, 0, 0);
    //pg.ellipse(myScreen.xp(plantL.l1 * cos_db(stateL[2] + 3.1415 * 0.5)),
    //      myScreen.yp(plantL.l1 * sin_db(stateL[2] + 3.1415 * 0.5)), 20, 20);
          
    pg.strokeWeight(15);
    pg.stroke(200, 0, 0);
    pg.line(myScreen.xp(0), myScreen.yp(-1.5), myScreen.xp(uT * 0.01), myScreen.yp(-1.5));
    pg.textSize(24);
    pg.fill(200,0,0);
    String st = "" + (int)(uT * 100) / 100.0;
    pg.text(st, myScreen.xp(0), myScreen.yp(-1.72));
    
}

