class VidPort
{
  double xs,ys,x0,y0;
  VidPort(double a,double b, double c,double d)
  {
    x0=c;
    y0=d;
    xs=800 / a;
    ys=800 / b;
  }
  int xp(double x)
  {
    return((int)((x0+x)*xs+0.5));
  }
  int yp(double y)
  {
    return(800-(int)((y0+y)*ys+0.5));
  }
  
  
  double xpR(int x)
  {
    return((x - 0.5) / xs - x0);
  }
  
  double ypR(int y)
  {
    return( -(y - height + 0.5) / ys - y0);
  }
}

