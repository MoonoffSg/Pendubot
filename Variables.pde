double[]      packData(double A, double B[])
{
  int n1      = B.length,
      indRET  = 0;
      
  double ret[] = new double[n1 + 1];
  
  ret[indRET++] = A;
  for(int i = 0; i < n1; i++)
   ret[indRET++] = B[i];
    
  return ret;
}

double[]      packData(double A[][], double B[], double C[], double D[][])
{
  int n1      = A.length, 
      m1      = A[0].length,
      n2      = B.length,
      n3      = C.length,
      n4      = D.length,
      indRET  = 0;
      
  double ret[] = new double[n1 * m1 + n2 + n3 + n4];
  
  for(int i = 0; i < n1; i++)
   for(int j = 0; j < m1 ; j++)
     ret[indRET++] = A[i][j];
     
  for(int i = 0; i < n2; i++)
    ret[indRET++] = B[i];
  
  for(int i = 0; i < n3; i++)
    ret[indRET++] = C[i];
    
  for(int i = 0; i < n4; i++)
    ret[indRET++] = D[i][0];
    
  return ret;
}

